    "theme": "dark",
    "typography": {
        "fontSizeLarge": "20",
        "fontSizeSmall": "13",
        "fontWeight": "500",
        "fontSize": "15"
    },
    "controls": {
        "listRowHeight": "56",
        "buttonHeight": "48",
        "touchTarget": "true",
        "inputHeight": "48"
    },
    "navigation": {
        "position": "bottom",
