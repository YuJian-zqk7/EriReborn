        "background": "#16161F",
        "surface": "#1E1E2A",
        "surfaceAlt": "#26263A",
        "foreground": "#E6E6F0",
        "muted": "#8A8AA0",
        "border": "#33334A"
    },
    "metrics": {
        "cornerRadius": "6",
        "density": "comfortable"
    },
    "fontFamily": "Cascadia Mono, Microsoft YaHei UI, Segoe UI",
