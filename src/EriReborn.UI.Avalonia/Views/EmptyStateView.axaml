<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:EriReborn.UI.Avalonia.Controls"
             x:Class="EriReborn.UI.Avalonia.Views.EmptyStateView">
  <!-- Shown only while the collection it is given is empty. The illustration comes
       from the asset library by id; the sentence states the fact. -->
  <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,16,0,8">
    <Image Name="Art" Width="128" Height="128" Stretch="Uniform" VerticalAlignment="Center"
           controls:SkinElement.Id="empty.art" />
    <TextBlock Name="CaptionText" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
