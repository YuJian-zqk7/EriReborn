<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EriReborn.UI.Avalonia.Views.BlogView"
             xmlns:views="using:EriReborn.UI.Avalonia.Views"
             xmlns:vm="using:EriReborn.App.Shared.ViewModels"
             x:DataType="vm:BlogViewModel">
  <!-- 这一页自己滚动（页头由外壳钉住），和其它页保持同一套版式。 -->
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="6">
    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Text="博客" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SourceState}" TextWrapping="Wrap" Classes="muted" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <!-- 商城有自己的一页，这里不再放第二个入口：同一件事两个按钮，只会让人猜哪个才是正式的。 -->
          <Button Content="重新加载" Command="{Binding LoadCommand}" Classes="primary" />
        </StackPanel>
        <views:EmptyStateView ItemsSource="{Binding Posts}" AssetId="empty_no_blog" Caption="公告还没有内容。" />
        <ItemsControl ItemsSource="{Binding Posts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Date}" Classes="muted" />
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
  </ScrollViewer>

</UserControl>
